# ShopDesk web app — copy to .env.local for development or .env.production for builds.
VITE_APP_NAME=ShopDesk
# API base URL. Default: same origin /api/v1 (Vite dev/preview proxy, reverse proxy in production).
# VITE_API_URL=https://api.example.com/api/v1
# Where the dev/preview server proxies /api and /storage.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Enable the service worker during `npm run dev` (normally only in production builds).
# VITE_PWA_DEV=true
