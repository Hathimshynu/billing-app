# ---------------------------------------------------------------------------
# ShopDesk API — environment template. Copy to .env and fill in. Never commit .env.
# See docs/DEPLOYMENT.md for production values.
# ---------------------------------------------------------------------------
APP_NAME="ShopDesk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origin(s) of the web app, comma separated (used for CORS when not served from the same origin).
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
# All timestamps are stored in UTC; each business has its own timezone (default Asia/Kolkata).
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_SYNC_LEVEL=info

# --- Database -----------------------------------------------------------------
# Local development works out of the box with SQLite (database/database.sqlite).
DB_CONNECTION=sqlite
# Production: MySQL 8 / MariaDB 10.6+ / PostgreSQL 14+
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=shopdesk
# DB_USERNAME=shopdesk
# DB_PASSWORD=

# --- Auth (Laravel Sanctum bearer tokens) ------------------------------------------
# Token lifetime in minutes (default 30 days; devices work offline for long periods).
SANCTUM_EXPIRATION=43200

# --- Cache / queue / sessions ----------------------------------------------------
# Development: database. Production: redis.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@shopdesk.test"
MAIL_FROM_NAME="${APP_NAME}"
