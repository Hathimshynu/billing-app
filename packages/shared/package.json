{
  "name": "@shopdesk/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared domain logic, types and validation for ShopDesk (pricing, tax, numbering, sync contracts)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
